generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  HEAD
  TEACHER
  STUDENT
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model User {
  id                 String   @id @default(cuid())
  username           String   @unique
  passwordHash       String
  role               Role
  name               String
  isActive           Boolean  @default(true)
  profileImg         String?
  profileImgPublicId String?
  totalTasks         Int      @default(0)
  checkedTasks       Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  taughtTasks             Task[]                            @relation("TeacherTasks")
  assignedTasks           Task[]                            @relation("StudentTasks")
  dailyRecords            DailyRecord[]
  awardStats              StudentAwardStats?
  createdTaskTemplates    TaskTemplate[]                    @relation("CreatedTaskTemplates")
  createdRoutineTemplates RoutineTemplate[]                 @relation("CreatedRoutineTemplates")
  templateTaskItems       TaskTemplateItem[]                @relation("TemplateTaskTeachers")
  weeklyAssignments       StudentWeeklyTemplateAssignment[]
  taskSubmissions         TaskSubmission[]
  taskReviews             TaskReview[]                      @relation("TeacherTaskReviews")
  awardEvents             StudentAwardEvent[]

  @@index([role])
  @@index([username])
}

model DailyRecord {
  id             String   @id @default(cuid())
  studentId      String
  date           DateTime @db.Date
  isWorking      Boolean  @default(true)
  taskTemplateId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  taskTemplate TaskTemplate? @relation("DailyRecordTaskTemplate", fields: [taskTemplateId], references: [id], onDelete: SetNull)

  tasks Task[]

  @@unique([studentId, date])
  @@index([studentId])
  @@index([date])
  @@index([taskTemplateId])
}

model TaskCategory {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks Task[]

  @@index([name])
}

model Task {
  id            String    @id @default(cuid())
  dailyRecordId String
  studentId     String
  teacherId     String
  categoryId    String
  title         String
  description   String?
  deadline      DateTime?
  difficulty    Int
  score         Int?
  isCompleted   Boolean   @default(false)
  isDelayed     Boolean   @default(false)
  isChecked     Boolean   @default(false)
  isCorrect     Boolean   @default(false)
  completedAt   DateTime?
  checkedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  dailyRecord DailyRecord @relation(fields: [dailyRecordId], references: [id],onDelete: Cascade)

  student User @relation("StudentTasks",fields: [studentId],references: [id],onDelete: Cascade)

  teacher User @relation("TeacherTasks",fields: [teacherId],references: [id],onDelete: Restrict)

  category TaskCategory @relation(fields: [categoryId],references: [id],onDelete: Restrict)

  submissions TaskSubmission[]
  review      TaskReview?

  @@index([dailyRecordId])
  @@index([studentId])
  @@index([teacherId])
  @@index([categoryId])
  @@index([deadline])
  @@index([isCompleted])
  @@index([isChecked])
}

model TaskSubmission {
  id          String   @id @default(cuid())
  taskId      String
  studentId   String
  note        String?
  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  task Task @relation(fields: [taskId],references: [id],onDelete: Cascade)

  student User @relation(fields: [studentId],references: [id],onDelete: Cascade)

  media TaskSubmissionMedia[]

  @@index([taskId])
  @@index([studentId])
  @@index([submittedAt])
}

model TaskSubmissionMedia {
  id           String   @id @default(cuid())
  submissionId String
  url          String
  publicId     String
  resourceType String
  fileName     String
  format       String?
  bytes        Int?
  createdAt    DateTime @default(now())

  submission TaskSubmission @relation(fields: [submissionId],references: [id],onDelete: Cascade)

  @@index([submissionId])
}

model TaskReview {
  id        String   @id @default(cuid())
  taskId    String   @unique
  teacherId String
  score     Float
  note      String?
  checkedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task Task @relation(fields: [taskId],references: [id],onDelete: Cascade)

  teacher User @relation("TeacherTaskReviews",fields: [teacherId],references: [id],onDelete: Restrict)

  @@index([teacherId])
}

model StudentAwardStats {
  id                 String    @id @default(cuid())
  studentId          String    @unique
  dailyAwards        Int       @default(0)
  weeklyAwards       Int       @default(0)
  monthlyAwards      Int       @default(0)
  streak3DaysAwards  Int       @default(0)
  streak7DaysAwards  Int       @default(0)
  streak14DaysAwards Int       @default(0)
  streak30DaysAwards Int       @default(0)
  streak60DaysAwards Int       @default(0)
  streak90DaysAwards Int       @default(0)
  overallAwardDays   Int       @default(0)
  currentStreak      Int       @default(0)
  longestStreak      Int       @default(0)
  lastStreakDate     DateTime? @db.Date
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  student User @relation(fields: [studentId],references: [id],onDelete: Cascade)
}

model StudentAwardEvent {
  id        String   @id @default(cuid())
  studentId String
  type      String
  periodKey String
  createdAt DateTime @default(now())

  student User @relation(fields: [studentId],references: [id],onDelete: Cascade)

  @@unique([studentId, type, periodKey])
  @@index([studentId])
  @@index([type])
  @@index([periodKey])
}

model TaskTemplate {
  id          String   @id @default(cuid())
  name        String
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User @relation("CreatedTaskTemplates",fields: [createdById],references: [id],onDelete: Restrict)

  categories TaskTemplateCategory[]
  items      TaskTemplateItem[]

  weeklyAssignments StudentWeeklyTemplateAssignment[]

  dailyRecords DailyRecord[] @relation("DailyRecordTaskTemplate")

  @@index([createdById])
  @@index([name])
}

model TaskTemplateCategory {
  id         String   @id @default(cuid())
  templateId String
  name       String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  template TaskTemplate @relation(fields: [templateId],references: [id],onDelete: Cascade)

  tasks TaskTemplateItem[]

  @@index([templateId])
  @@index([sortOrder])
}

model TaskTemplateItem {
  id          String   @id @default(cuid())
  templateId  String
  categoryId  String
  teacherId   String
  title       String
  description String?
  deadline    String?
  difficulty  Int
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  template TaskTemplate @relation(fields: [templateId],references: [id],onDelete: Cascade)

  category TaskTemplateCategory @relation(fields: [categoryId],references: [id],onDelete: Cascade)

  teacher User @relation("TemplateTaskTeachers",fields: [teacherId],references: [id],onDelete: Restrict)

  @@index([templateId])
  @@index([categoryId])
  @@index([teacherId])
  @@index([sortOrder])
}

model RoutineTemplate {
  id          String   @id @default(cuid())
  name        String
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User @relation("CreatedRoutineTemplates",fields: [createdById],references: [id],onDelete: Restrict)

  items RoutineTemplateItem[]

  weeklyAssignments StudentWeeklyTemplateAssignment[]

  @@index([createdById])
  @@index([name])
}

model RoutineTemplateItem {
  id          String   @id @default(cuid())
  templateId  String
  title       String
  description String?
  startTime   String
  endTime     String
  durationMin Int
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  template RoutineTemplate @relation(fields: [templateId],references: [id],onDelete: Cascade)

  @@index([templateId])
  @@index([sortOrder])
}

model StudentWeeklyTemplateAssignment {
  id                String    @id @default(cuid())
  studentId         String
  dayOfWeek         DayOfWeek
  taskTemplateId    String?
  routineTemplateId String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  student User @relation(fields: [studentId],references: [id],onDelete: Cascade)

  taskTemplate TaskTemplate? @relation(fields: [taskTemplateId],references: [id],onDelete: SetNull)

  routineTemplate RoutineTemplate? @relation(fields: [routineTemplateId],references: [id],onDelete: SetNull)

  @@unique([studentId, dayOfWeek])
  @@index([studentId])
  @@index([dayOfWeek])
  @@index([taskTemplateId])
  @@index([routineTemplateId])
}